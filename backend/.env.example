# =============================================================================
# StellarHunts — Backend Environment Configuration
# =============================================================================
#
# Copy this file to `.env` and fill in the values for your environment.
# Never commit `.env` to version control.
#
# Every variable listed here is validated at startup by the Joi schema in
# `src/config/config.validation.ts`. Unknown variables are allowed but
# documented variables that have the wrong type or are missing (when required)
# will prevent the application from starting.
#
# =============================================================================
# APPLICATION
# =============================================================================

# Runtime environment. Affects logging, error verbosity, and Stellar mode guards.
# Allowed values: development | test | production
NODE_ENV=development

# Port the NestJS HTTP server listens on.
PORT=3001

# URL of the Next.js frontend. Used for CORS and redirect URLs.
FRONTEND_URL=http://localhost:3000

# =============================================================================
# AUTHENTICATION
# =============================================================================

# REQUIRED. Secret key used to sign JWT access and refresh tokens.
# Generate a strong random value: openssl rand -hex 32
JWT_SECRET=

# Expiry duration for short-lived access tokens (parsed by the `ms` library).
# Examples: 15m, 1h, 1d
JWT_EXPIRES_IN=15m

# Expiry duration for long-lived refresh tokens.
# Examples: 7d, 30d
JWT_REFRESH_EXPIRES_IN=30d

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================

# REQUIRED. PostgreSQL connection details.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_NAME=stellarshunts

# Synchronise the TypeORM schema with the database on startup.
# Booleans: exactly `true` enables the flag; anything else is rejected at
# startup rather than being silently treated as false.
# WARNING: Do NOT set to true in production — use migrations instead.
DATABASE_SYNC=false

# Seed the database with fixture data on startup (used in development/test only).
DATABASE_LOAD=false

# =============================================================================
# STELLAR / SOROBAN
# =============================================================================
#
# STELLAR_MODE controls whether the backend calls live Soroban contracts or
# uses a local mock that returns synthetic results.
#
# The schema DEFAULT is `live` (fail-closed). A deployment that omits this
# variable without Soroban credentials will FAIL AT STARTUP, naming every
# missing key. This is intentional — the alternative (defaulting to `mock`)
# would cause the app to boot cleanly and then hand out NFT badges that were
# never actually minted on-chain.
#
# For local development with no Stellar setup, set STELLAR_MODE=mock.
# The line below is the local-development opt-in — copy it as-is.
STELLAR_MODE=mock

# Stellar network to connect to.
# Allowed values: testnet | pubnet
# NOTE: `mainnet` is the old name for `pubnet` and is rejected by the schema.
STELLAR_NETWORK=testnet

# RPC endpoint for the Soroban-enabled Stellar node.
# In `live` mode this is REQUIRED; in `mock` mode it may be omitted.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Soroban contract IDs — REQUIRED in `live` mode, optional in `mock` mode.
# Example format: CA3D5KRYM6CB7OWQ6TWYRR3Z4T7GNZLKERYNZGGA5SOAOPIFY6YQGAXE
SOROBAN_NFT_CONTRACT_ID=
STELLAR_HUNTS_CONTRACT_ID=
STELLAR_HUNTS_NFT_CONTRACT_ID=

# =============================================================================
# REDIS (optional)
# =============================================================================
#
# Redis is used for Socket.IO pub/sub, rate limiting, and response caching.
# The application boots with degraded caching when these are unset, but
# real-time multiplayer and rate limiting will not function correctly.
#
# You can configure Redis either via a single URL or via individual host/port
# settings. If both are set, REDIS_URL takes precedence.

# REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# =============================================================================
# LOAD TESTING
# =============================================================================

# Target requests-per-second for load testing scripts (e.g., k6 scenarios).
# Only used by load test tooling — has no effect on the running application.
# LOAD_TEST_TARGET_RPS=100
